# ============ 复制为 .env 后修改，切勿把 .env 提交到仓库 ============

# 对外端口（NAS 上被占用可改为 3081 等）
APP_PORT=3080

# 时区
TZ=Asia/Shanghai

# 数据目录：数据库文件存放位置，必须是宿主机上的绝对路径
# 示例：/volume1/docker/workflow-tracker/data
DATA_PATH=./data

# 首次启动创建的管理员账号（仅在数据库为空时生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成你的强密码
ADMIN_DISPLAY_NAME=系统管理员

# 构建时的 npm 源。国内网络建议用 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmmirror.com

# 通过 HTTPS 反向代理访问时设为 1
COOKIE_SECURE=0

# Obsidian 知识库路径（可选，需同时在上方 compose 的 volumes 中取消注释）
# OBSIDIAN_PATH=/volume1/homes/你的用户名/Documents/Obsidian
