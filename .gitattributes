# 统一换行符，避免 Windows 提交后 Linux/NAS 上脚本无法执行
* text=auto eol=lf

# Shell 脚本必须保持 LF，否则容器内无法执行
*.sh text eol=lf
Dockerfile text eol=lf

# Windows 批处理/PowerShell/Inno Setup 必须保持 CRLF，否则 cmd.exe 解析可能出错
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.docx binary
*.xlsx binary
*.pptx binary
*.pdf binary
*.db binary
