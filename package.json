{
  "name": "workflow-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "工作流程跟踪工作台 - 本地化部署的工作管理与总结报告系统",
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev -p 3080",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start -p 3080",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:unit": "node scripts/test-cadence.cjs",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "date-fns": "^4.1.0",
    "docx": "^9.5.1",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
